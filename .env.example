# Copy to `.env` (local) or set in your hosting provider's dashboard (production).

# Public base URL of the site — used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# REQUIRED IN PRODUCTION — Slack Incoming Webhook that receives applications and contact messages.
# Create one at https://api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook,
# and pick a private channel such as #applications. Keep this URL secret.
# Locally it can stay empty: submissions are printed in the dev server console instead.
# In production, if it is missing, forms show an error asking visitors to try again later.
SLACK_WEBHOOK_URL=

# OPTIONAL — Acknowledgement emails to applicants via Resend (https://resend.com).
# EMAIL_FROM must use a domain you have verified in Resend, in the form: Scavelo Learning Studio <address@your-domain>
RESEND_API_KEY=
EMAIL_FROM=
# Optional: also email the instructor a short notice and use this address for replies.
INSTRUCTOR_EMAIL=

# OPTIONAL BUT RECOMMENDED IN PRODUCTION — Cloudflare Turnstile CAPTCHA
# (https://developers.cloudflare.com/turnstile/). Honeypot, timing checks and
# per-IP rate limits are always active; Turnstile adds protection across server instances.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
