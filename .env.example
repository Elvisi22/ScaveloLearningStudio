# Copy to `.env` for local development. Nothing is required: the site runs without any of these.
# On GitHub Pages these are provided by the workflow (.github/workflows/deploy-pages.yml).

# Public base URL — used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sub-folder the site is served from, e.g. "/ScaveloLearningStudio" on github.io. Empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Where the application and contact forms post submissions (a relay that forwards to Slack).
# While empty, the forms show "online submissions open soon" and don't submit.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional Cloudflare Turnstile CAPTCHA site key (the secret key belongs in the relay, never here).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
